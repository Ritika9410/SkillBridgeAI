# Copy this file to .env.local for machine-specific settings.
# Resume and skill-gap analysis use Gemini. Get a key from Google AI Studio.

# Optional Next.js runtime settings (defaults shown):
DIST_DIR=.next
WATCH_IGNORED_PATHS=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# MongoDB Atlas connection and signed login sessions.
MONGODB_URI=
MONGODB_DB=skillbridgeai
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
